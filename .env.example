# Copy this file to .env and fill in the values. Never share .env or paste it into a chat.

# ---- Zoho (India data center) ----
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Filled in for you by:  python -m sbsync auth <grant_code>
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in

# ---- Superbud ----
SUPERBUD_API_URL=https://api.superbud.io/graphql
SUPERBUD_API_KEY=
# Leave empty: found automatically from the API key
SUPERBUD_DISTRIBUTOR_ID=

# ---- Behaviour ----
# false = dry run (reads everything, writes nothing, report shows what WOULD change)
LIVE=false
# How far back to look for orders on each run (older open orders are re-checked anyway)
ORDER_LOOKBACK_DAYS=120
# on_activity = create a Dispensary only when a Superbud store that isn't in Zoho places an order
# true = create every missing Superbud store now, false = never create
CREATE_NEW_DISPENSARIES=on_activity
# Create a Product in Zoho for Superbud products with no sub-category + flavour match
CREATE_NEW_PRODUCTS=true
# Also create Deals for DRAFT orders (normally only placed orders)
SYNC_DRAFT_ORDERS=false
# unit = Superbud pack price / pack size (matches your current Zoho prices, e.g. $1.50); pack = full case price
PRODUCT_PRICE_MODE=unit
# Zoho -> Superbud: push Dispensary shipping address changes to the Superbud location
PUSH_LOCATIONS_TO_SUPERBUD=false
